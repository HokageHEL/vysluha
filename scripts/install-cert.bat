@echo off
chcp 65001 >nul
echo ========================================================
echo   Встановлення сертифіката для застосунку "Вислуга 360"
echo ========================================================
echo.
echo Цей скрипт додає цифровий сертифікат у "Довірені кореневі центри",
echo щоб Windows SmartScreen та антивірус не показували попереджень.
echo.

set CERT_FILE=%~dp0Vysluha360_Certificate.cer

if not exist "%CERT_FILE%" (
    echo [ПОМИЛКА] Файл сертифіката не знайдено поруч зі скриптом:
    echo %CERT_FILE%
    echo Переконайтеся, що файл Vysluha360_Certificate.cer лежить в одній папці з цим файлом.
    pause
    exit /b 1
)

echo Встановлення сертифіката для поточного користувача...
certutil -user -addstore "Root" "%CERT_FILE%"

if %ERRORLEVEL% equ 0 (
    echo.
    echo [УСПІХ] Сертифікат успішно додано до довірених!
    echo Тепер застосунок "Вислуга 360" запускатиметься без попереджень SmartScreen.
) else (
    echo.
    echo [УВАГА] Не вдалося автоматично встановити сертифікат.
    echo Спробуйте клікнути двічі на Vysluha360_Certificate.cer і обрати:
    echo "Встановити сертифікат" - "Поточний користувач" - "Помістити всі сертифікати в наступне сховище" - "Довірені кореневі центри сертифікації".
)

echo.
pause
